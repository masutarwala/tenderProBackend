DATABASE_URL="postgresql://<user>:<password>@<your-neon-host>.neon.tech/<dbname>?sslmode=require"
JWT_SECRET="change-this-dev-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"

