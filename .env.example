DATABASE_URL="postgresql://<user>:<password>@<your-neon-host>.neon.tech/<dbname>?sslmode=require"
JWT_SECRET="change-this-dev-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
TEMP_UPLOAD_DIR="./temp/uploads"

# Document uploads (To Client / From Client): files are staged locally under
# TEMP_UPLOAD_DIR, then moved to Cloudinary when the Document record is saved.
# Note: the cloudinary SDK parses CLOUDINARY_URL at import time, so it must
# always be a syntactically valid cloudinary://key:secret@cloud_name URL.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_API_KEY="<api_key>"
CLOUDINARY_API_SECRET="<api_secret>"

# --- Future swap-in: Azure AD SSO (not used yet, local email/password auth is active) ---
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
