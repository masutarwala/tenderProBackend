generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum TenderType {
  HARDWARE
  SOFTWARE
  SERVICES
}

// Single source of truth for tender pipeline progress, shown everywhere as one
// Stage + Status pair. Both are now manually editable (by Admin or the
// assigned Bidder) rather than automatically gated.
enum TenderStage {
  EVALUATION
  PREPARATION
  SUBMISSION
}

enum EmdStatus {
  PENDING
  PAID
}

enum TenderStatus {
  PENDING
  COMPLETED
}

enum Outcome {
  WON
  LOST
  DROPPED // Legacy / settable from any stage, not just Evaluation
  NO_GO
  DROPPED_BY_US
  WITHDRAWN_BY_CLIENT
}

enum AwardCriteria {
  AUCTION
  LOWEST
  QCBS
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum DocumentSide {
  TO_CLIENT
  FROM_CLIENT
}

// ============ USERS ============

// RBAC removed: a user is either an Admin (full access) or a normal user
// scoped by menuKeys. No Role model, no per-role permissions.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isAdmin      Boolean  @default(false)
  canAddTender Boolean  @default(false)
  // Which of the 4 left-nav menus this user can see: "dashboard" | "my-bids" |
  // "users" | "task-list". Admins see all 4 regardless of this list.
  menuKeys     String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bidderOn         Tender[]     @relation("TenderBidder")
  salesExecOn      Tender[]     @relation("TenderSalesExec")
  auditLogs        AuditLog[]
  documentsUploaded Document[]
  assignedTasks    TenderTask[] @relation("TaskAssignedUser")
  completedTasks   TenderTask[] @relation("TaskCompletedBy")
  comments         Comment[]
}

// ============ TRANSACTIONAL ============

model Tender {
  id          String @id @default(cuid())
  // Internal auto-increment used only to derive the display-facing "TENDER001"
  // style ID (see formatTenderId() in tenders.routes.ts) — not exposed directly.
  tenderSeq   Int    @unique @default(autoincrement())
  tenderRefNo String @unique
  title       String
  description String?

  tenderType TenderType
  stage      TenderStage  @default(EVALUATION)
  status     TenderStatus @default(PENDING)

  publishedDate  DateTime?
  closingDate    DateTime?
  preBidDate     DateTime?
  bidOpeningDate DateTime?

  // Financial section (Tender Layout wireframe)
  tenderValue     Float? // "Bid Worth" — initial estimated value
  bidValue        Float? // "Bid Value" — entered/updated later
  emdAmount       Float?
  emdStatus       EmdStatus?  @default(PENDING)
  awardCriteria   AwardCriteria?
  bidValidity     String?
  securityDeposit String?
  slaPenalties    String?
  paymentTerms    String?
  contractPeriod  String?

  // Customer Relation
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  
  decisionDate    DateTime?

  bidderId    String?
  bidder      User?   @relation("TenderBidder", fields: [bidderId], references: [id])
  salesExecId String?
  salesExec   User?   @relation("TenderSalesExec", fields: [salesExecId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcomeRecord OutcomeRecord?
  tasks         TenderTask[]
  comments      Comment[]
  documents     Document[]
}

model OutcomeRecord {
  id               String    @id @default(cuid())
  tenderId         String    @unique
  tender           Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  outcome          Outcome
  decisionDate     DateTime?
  winningBidAmount Float? // "Winning Bid Value"
  winner           String?
  reasonForLoss    String?
  recordedById     String?
  recordedAt       DateTime  @default(now())
  isEmdRecovered   Boolean   @default(false)
  emdRecoveryDate  DateTime?
}

// Reusable master list ("Title" + "Required?" only) that Admin maintains —
// importing a template onto a tender bulk-creates one TenderTask per row,
// pre-assigned to that tender's Bidder (reassignable afterwards).
model TaskTemplate {
  id            String       @id @default(cuid())
  title         String
  isRequired    Boolean      @default(true)
  stage         TenderStage?
  dueDaysOffset Int?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
}

// Flat per-tender task list — replaces the old checklist + approval system.
// No phase scoping; a single list per tender. Only the assigned user (or an
// Admin) may mark their own task complete.
model TenderTask {
  id             String      @id @default(cuid())
  tenderId       String
  tender         Tender      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  title          String
  assignedUserId String?
  assignedUser   User?       @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  isRequired     Boolean     @default(true)
  stage          TenderStage?
  dueDate        DateTime?
  order          Int         @default(0)
  status         TaskStatus  @default(PENDING)
  completedById  String?
  completedBy    User?       @relation("TaskCompletedBy", fields: [completedById], references: [id])
  completedDate  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  comments       Comment[]
}

// Append-only comment log per tender, visible across every stage — replaces
// the old scattered single-purpose "remarks" fields.
model Comment {
  id        String       @id @default(cuid())
  tenderId  String
  tender    Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  message   String
  stage     TenderStage
  status    TenderStatus
  // Set when this comment was auto-generated by completing a task — lets the
  // UI badge it as a "Task Comment" and show which task it belongs to.
  taskId    String?
  task      TenderTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

// Generic per-tender document, storage delegated to storage adapter (local
// disk in dev; swaps to SharePoint/Microsoft Graph in production — see
// storageAdapter.ts). Two tabs only: To Client / From Client.
model Document {
  id           String       @id @default(cuid())
  tenderId     String
  tender       Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  side         DocumentSide
  title        String?
  fileName     String
  url          String
  publicId     String
  resourceType String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String // CREATE/UPDATE/DELETE
  resourceType String
  resourceId   String?
  diff         String? // JSON string
  ipAddress    String?
  createdAt    DateTime @default(now())
}

// ============ CUSTOMERS ============

model Customer {
  id                 String   @id @default(cuid())
  name               String
  city               String
  state              String
  country            String   @default("India")
  address            String?
  email              String?
  phone              String?
  contactName        String?
  contactDesignation String?
  contactEmail       String?
  contactPhone       String?

  relatedToId        String?
  relatedTo          Customer?  @relation("CustomerHierarchy", fields: [relatedToId], references: [id], onDelete: SetNull)
  branches           Customer[] @relation("CustomerHierarchy")

  tenders            Tender[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
